/target
# Образ диска для virtio-blk (Веха 7.1). Создать: truncate -s 16M void-disk.img
/void-disk.img
# target отдельно собираемых userspace-программ (кроме сборки через kernel/build.rs → OUT_DIR)
/programs/*/target/
# target хост-утилит (Веха 29) — тоже отдельные крейты со своим таргетом
/tools/*/target/
# Загрузочный ISO для реального железа (Веха 41). Собрать: boot/mkboot.sh
/boot/void.iso
# Загрузочный образ диска (Веха 48) — исходник модуля установки. Собрать: boot/mkdisk.sh
/boot/void-disk-boot.img
