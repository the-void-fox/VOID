# Скриншоты/фото для обсуждения (не исходники)
/IMG/

# Собранные образы диска — артефакты сборки, не исходники (700 МиБ каждый).
/Code/boot/void-x54c.img

# C-драйверы, выложенные stage-drivers.sh, — артефакты сборки nix, не исходники.
/Code/programs/lx-linux/prebuilt/

# Референс-исходники для чтения (niri, smithay, Redox, genode, resvg/usvg, Intel SDM) — 380+ МБ
# ЧУЖОГО кода и PDF. Лежат в дереве, чтобы их можно было читать офлайн, но в репозиторий VOID
# им нельзя: это не наши исходники, и один `git add -A` утащил бы их целиком.
/Reference/

# Рабочий каталог сессий (сценарии прогонов, черновики) — не исходники.
/scratchpad/

# Кэш интерпретатора python у инструментов.
__pycache__/
